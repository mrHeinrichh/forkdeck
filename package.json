{
  "name": "forkdeck",
  "version": "1.1.2",
  "description": "A visual local Git workspace for branches, commits, stash, diffs, and commit identities.",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node server.js",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/*.test.js\"",
    "start": "node server.js",
    "desktop": "electron .",
    "prepare": "node scripts/vendor.js",
    "dist": "node scripts/build-desktop.js",
    "dist:mac": "node scripts/build-desktop.js --mac --arm64 --x64",
    "dist:win": "node scripts/build-desktop.js --win --x64",
    "smoke:desktop": "node scripts/smoke-desktop.js",
    "test:ui": "node scripts/test-ui.js"
  },
  "keywords": [
    "git",
    "github",
    "identity",
    "commits"
  ],
  "author": {
    "name": "Heinric Fabros",
    "url": "https://mrheinrich.vercel.app/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrHeinrichh/forkdeck.git"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "lucide": "1.47.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.mrheinrichh.forkdeck",
    "productName": "ForkDeck",
    "asar": true,
    "afterPack": "scripts/prepare-macos-sign.js",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "artifactName": "ForkDeck-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "strictVerify": true,
      "notarize": false,
      "timestamp": "none",
      "minimumSystemVersion": "13.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "ForkDeck ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ForkDeck"
    },
    "publish": null
  }
}
